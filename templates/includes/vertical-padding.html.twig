{#-
  The legacy exo vertical padding as classes: 16px on phones, 65% of the
  value (at least 16px) from 640px, the value from lg; 0 for none. As a page's
  first or last section the page offsets replace it
  (--spacing-component-t/-b, front's _utilities.css), as legacy did.
  - top, bottom: pixel values, 0 to 100 in tens (default 30).
  Prints the classes.
-#}
{%- set tops = {
  '0': 'pt-[var(--spacing-component-t,0px)]',
  '10': 'pt-[var(--spacing-component-t,1rem)] lg:pt-[var(--spacing-component-t,0.625rem)]',
  '20': 'pt-[var(--spacing-component-t,1rem)] lg:pt-[var(--spacing-component-t,1.25rem)]',
  '30': 'pt-[var(--spacing-component-t,1rem)] min-[40em]:pt-[var(--spacing-component-t,1.21875rem)] lg:pt-[var(--spacing-component-t,1.875rem)]',
  '40': 'pt-[var(--spacing-component-t,1rem)] min-[40em]:pt-[var(--spacing-component-t,1.625rem)] lg:pt-[var(--spacing-component-t,2.5rem)]',
  '50': 'pt-[var(--spacing-component-t,1rem)] min-[40em]:pt-[var(--spacing-component-t,2.03125rem)] lg:pt-[var(--spacing-component-t,3.125rem)]',
  '60': 'pt-[var(--spacing-component-t,1rem)] min-[40em]:pt-[var(--spacing-component-t,2.4375rem)] lg:pt-[var(--spacing-component-t,3.75rem)]',
  '70': 'pt-[var(--spacing-component-t,1rem)] min-[40em]:pt-[var(--spacing-component-t,2.84375rem)] lg:pt-[var(--spacing-component-t,4.375rem)]',
  '80': 'pt-[var(--spacing-component-t,1rem)] min-[40em]:pt-[var(--spacing-component-t,3.25rem)] lg:pt-[var(--spacing-component-t,5rem)]',
  '90': 'pt-[var(--spacing-component-t,1rem)] min-[40em]:pt-[var(--spacing-component-t,3.65625rem)] lg:pt-[var(--spacing-component-t,5.625rem)]',
  '100': 'pt-[var(--spacing-component-t,1rem)] min-[40em]:pt-[var(--spacing-component-t,4.0625rem)] lg:pt-[var(--spacing-component-t,6.25rem)]',
} -%}
{%- set bottoms = {
  '0': 'pb-[var(--spacing-component-b,0px)]',
  '10': 'pb-[var(--spacing-component-b,1rem)] lg:pb-[var(--spacing-component-b,0.625rem)]',
  '20': 'pb-[var(--spacing-component-b,1rem)] lg:pb-[var(--spacing-component-b,1.25rem)]',
  '30': 'pb-[var(--spacing-component-b,1rem)] min-[40em]:pb-[var(--spacing-component-b,1.21875rem)] lg:pb-[var(--spacing-component-b,1.875rem)]',
  '40': 'pb-[var(--spacing-component-b,1rem)] min-[40em]:pb-[var(--spacing-component-b,1.625rem)] lg:pb-[var(--spacing-component-b,2.5rem)]',
  '50': 'pb-[var(--spacing-component-b,1rem)] min-[40em]:pb-[var(--spacing-component-b,2.03125rem)] lg:pb-[var(--spacing-component-b,3.125rem)]',
  '60': 'pb-[var(--spacing-component-b,1rem)] min-[40em]:pb-[var(--spacing-component-b,2.4375rem)] lg:pb-[var(--spacing-component-b,3.75rem)]',
  '70': 'pb-[var(--spacing-component-b,1rem)] min-[40em]:pb-[var(--spacing-component-b,2.84375rem)] lg:pb-[var(--spacing-component-b,4.375rem)]',
  '80': 'pb-[var(--spacing-component-b,1rem)] min-[40em]:pb-[var(--spacing-component-b,3.25rem)] lg:pb-[var(--spacing-component-b,5rem)]',
  '90': 'pb-[var(--spacing-component-b,1rem)] min-[40em]:pb-[var(--spacing-component-b,3.65625rem)] lg:pb-[var(--spacing-component-b,5.625rem)]',
  '100': 'pb-[var(--spacing-component-b,1rem)] min-[40em]:pb-[var(--spacing-component-b,4.0625rem)] lg:pb-[var(--spacing-component-b,6.25rem)]',
} -%}
{{- tops[top ?? '30'] ~ ' ' ~ bottoms[bottom ?? '30'] -}}
