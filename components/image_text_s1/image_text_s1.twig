{#
  Image Text S1 — an image beside a heading, rich text and buttons.
  - From md the image and the text are halves of the container, centred on
    each other; the text keeps 2rem (8rem from lg) off the image. Phones
    stack the image above the text.
  - `position: right` puts the image on the right.
  - The text's last margin stays below it from md, where the legacy flex row
    kept it, and goes on phones, where it collapsed into the section's.
#}
{% set right = position == 'right' %}
<div {{ attributes.addClass('mna-ink') }}>
  <div class="container-center px-4 md:flex md:items-center">
    {% if image.src %}
      <div class="md:w-1/2 {{ right ? 'md:order-2' }}">
        {{ neo_image(image.uri ?: image.src, {
          sm: {op: 'scale', width: 640},
          md: {op: 'scale', width: 510},
          lg: {op: 'scale', width: 860},
        }, image.alt, '', {class: ['block', 'w-full', 'h-auto']}) }}
      </div>
    {% endif %}
    <div class="mt-4 md:mt-0 md:w-1/2 {{ right ? 'md:pr-8 lg:pr-32' : 'md:pl-8 lg:pl-32' }}">
      {% if heading or description %}
        <div{{ heading.size.addClass('space-y-4') }}>
          {% if heading.supertitle %}<div class="mna-supertitle">{{ heading.supertitle }}</div>{% endif %}
          {% if heading.title %}<h2 class="mna-title leading-[1.25]">{{ heading.title }}</h2>{% endif %}
          {% if heading.subtitle %}<div class="mna-subtitle">{{ heading.subtitle }}</div>{% endif %}
          {% if description %}<div class="mna-description mna-prose max-md:[&>:last-child]:mb-0 [&_li]:list-[square]">{{ description }}</div>{% endif %}
        </div>
      {% endif %}
      {% include '@mna_neo/includes/links.html.twig' with {links: links, class: 'mt-4 lg:mt-8'} only %}
    </div>
  </div>
</div>
